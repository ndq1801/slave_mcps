# Slack App Configuration
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

SLACK_USER_TOKEN=xoxp-your-user-token-here

# App-Level Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Slack User ID of your account (U...) - to check if you replied
SLACK_USER_ID=U1234567890

# Timeout duration in minutes before auto-replying (Default: 5)
AUTO_REPLY_TIMEOUT_MINUTES=5

# Default Auto-Reply Text
DEFAULT_REPLY_TEXT=Tôi hiện chưa có mặt, tôi sẽ xem tin nhắn và phản hồi lại bạn sau ít phút nữa.
