# Google Calendar OAuth 2.0 credentials (Desktop app). Obtain these from
# https://console.cloud.google.com -> APIs & Services -> Credentials.
# Then get the refresh token via the OAuth consent flow and set it below.
# Secrets - never commit this file.
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token

# Calendar to manage (default 'primary' = the account's main calendar).
GOOGLE_CALENDAR_ID=primary
# IANA timezone used for queries.
GOOGLE_CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
