# Daily Report app base URL
DAILY_REPORT_BASE_URL=https://daily-report.wpdevelop.online

# Account used to log in (KEEP THIS FILE PRIVATE - never share it)
DAILY_REPORT_USERNAME=your_email@gmail.com
DAILY_REPORT_PASSWORD=your_password

# Login form field name for the username (default: email).
# Some apps use "username" instead of "email".
DAILY_REPORT_LOGIN_FIELD=email
