# Backlog REST API base URL (no trailing slash).
BACKLOG_API_URL=https://backlog-api.innofly-software.com

# Account used for the Bearer login. Never commit the real .env.
BACKLOG_EMAIL=you@company.com
BACKLOG_PASSWORD=your_password

# Accept-Language sent with every request (default: vi).
BACKLOG_LANGUAGE=vi

# Optional: fallback company id when the login response has no current_company_id.
# BACKLOG_COMPANY_ID=
